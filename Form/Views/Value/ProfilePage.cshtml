@model Form.Models.SignForm
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_Layout";
}


    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-md-6">

                <div class="card shadow-lg p-4" style="border-radius: 15px;">

                    <h3 class="text-center mb-4">My Profile</h3>

                    <div class="list-group">

                        <div class="list-group-item">
                            <strong>User Name:</strong> @Model.UserName
                        </div>

                        <div class="list-group-item">
                            <strong>Email:</strong> @Model.Email
                        </div>

                        <div class="list-group-item">
                            <strong>Mobile:</strong> @Model.Mobile
                        </div>

                        <div class="list-group-item">
                        <strong>State:</strong> @ViewBag.stateName
                        </div>

                        <div class="list-group-item">
                        <strong>City:</strong> @ViewBag.cityName
                        </div>

                        <div class="list-group-item">
                            <strong>Address:</strong> @Model.Address
                        </div>

                    </div>

                    <!-- Buttons -->
                    <div class="mt-4 d-grid gap-2">

                        <form asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-secondary w-100">
                                Logout
                            </button>
                        </form>

                        <a asp-action="EditData" class="btn btn-primary w-100">
                            Edit Profile
                        </a>

                    @* <a method="post" asp-action="DeleteUser" class="btn btn-danger w-100">
                            Delete Account
                        </a> *@
                        <form method="post" asp-action="DeleteUser" onsubmit="return confirm('Are you sure you want to delete your account?');">
                        <button type="submit" class="btn btn-danger w-100">
        Delete My Account
    </button>
</form>

                    </div>

                </div>

            </div>

        </div>

    </div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

    var success = '@TempData["success"]';
    var error = '@TempData["Error"]';

    if (success && success !== '') {
    Swal.fire({
    icon: 'success',
    title: 'Success',
    text: success,
    timer: 3000,
    showConfirmButton: false
    });
    }

    if (error && error !== '') {
    Swal.fire({
    icon: 'error',
    title: 'Error',
    text: error,
    timer: 3000,
    showConfirmButton: false
    });
    }

    });
</script>



