@{
}

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card shadow-lg p-4 rounded-4" style="width: 400px;">
        
        <h3 class="text-center mb-2">Verify OTP</h3>
        <p class="text-muted text-center mb-4">
            Enter the 4-digit OTP sent to your email
        </p>

        <form method="post" asp-action="Check_OTP">
            
            <!-- OTP Input -->
            <div class="mb-3 text-center">
                <label class="form-label fw-semibold">OTP Code</label>
                <input type="text"
                       class="form-control text-center rounded-3 fs-5"
                       maxlength="4"
                       placeholder="----"
                       name="OTP"
                       required>
            </div>

            <!-- Submit Button -->
            <div class="d-grid mb-2">
                <button type="submit" class="btn btn-primary rounded-3">
                    Verify OTP
                </button>
            </div>

        </form>

        <!-- Back Link -->
        <div class="text-center mt-2">
            <a asp-action="Index" class="text-decoration-none">
                ← Back to Login
            </a>
        </div>

    </div>
</div>



